# Application Environment Configuration
APP_NAME="HOSPITAL HMS"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE="Africa/Khartoum"
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# Database Configuration (MySQL 8)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hospital_hms
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Session & Security
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=false
CSRF_PROTECTION=true

# Uploads & Storage
UPLOAD_MAX_FILE_SIZE_MB=25
ALLOWED_UPLOAD_MIMES=application/pdf,image/jpeg,image/png,application/dicom
